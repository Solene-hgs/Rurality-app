<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Rurality · Le train pour tous et partout</title>
<meta name="description" content="Rurality : navette à la demande qui relie chaque adresse aux gares et aux services essentiels.">
<meta name="theme-color" content="#13285A">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#13285A; --deep:#0C1A3D; --amber:#F2A71B; --rail:#C8323C;
  --paper:#F3F5FA; --surface:#FFFFFF; --ink:#14203D; --muted:#56627F; --line:#D5DCEA;
  --chip:#EEF2FA; --chip-on:#13285A; --chip-on-ink:#FFFFFF; --ok:#1E7A4C; --hover:#E6ECF8;
  --display:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  --body:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root{
    --paper:#0A1533; --surface:#13285A; --ink:#EEF2FA; --muted:#AAB6D3; --line:#2C4278;
    --chip:#1B3168; --chip-on:#F2A71B; --chip-on-ink:#0C1A3D; --ok:#5FD39A; --hover:#1F3A7A;
    color-scheme:dark;
  }
}
*,*::before,*::after{box-sizing:border-box}
html{font-size:100%;-webkit-text-size-adjust:100%}
html.big{font-size:122%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);line-height:1.5;min-height:100vh}
img,svg{max-width:100%}
button,input,select{font:inherit;color:inherit}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px;border-radius:6px}
h1,h2,h3{font-family:var(--display);font-weight:700;line-height:1.05;margin:0;letter-spacing:.01em}

/* En-tête */
.top{background:var(--navy);color:#fff;padding-top:env(safe-area-inset-top,0px);position:sticky;top:0;z-index:30}
.top-in{max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:1rem;padding:.55rem 1.1rem}
.brand{display:flex;align-items:center;gap:.8rem;color:#fff;text-decoration:none;margin-right:auto}
.brand .logo{background:#fff;border-radius:14px;padding:.3rem .55rem;display:flex}
.brand img{height:46px;width:auto;display:block}
.brand small{font-family:var(--display);font-size:1.05rem;letter-spacing:.06em;color:#C9D3EA;line-height:1.1}
.textsize{background:transparent;border:1.5px solid #4A619A;color:#fff;border-radius:999px;padding:.35rem .8rem;cursor:pointer;font-weight:700;white-space:nowrap}
.textsize[aria-pressed="true"]{background:var(--amber);border-color:var(--amber);color:var(--deep)}
nav.tabs{display:flex;gap:.25rem}
nav.tabs a{color:#DCE3F3;text-decoration:none;padding:.5rem .8rem;border-radius:8px;font-weight:700;display:flex;align-items:center;gap:.4rem}
nav.tabs a[aria-current="page"]{background:#1F3A7A;color:#fff;box-shadow:inset 0 -3px 0 var(--amber)}
nav.tabs svg{width:20px;height:20px;flex:none}

main{max-width:1180px;margin:0 auto;padding:1.4rem 1.1rem 6rem}
.view{display:none}
.view.on{display:block}
.lead{max-width:64ch;color:var(--muted);margin:.4rem 0 1.4rem}
.title{font-size:clamp(2rem,5vw,2.9rem)}

/* Réservation */
.book{display:grid;gap:1.4rem}
@media (min-width:960px){.book{grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:start}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.2rem}
fieldset{border:0;margin:0 0 1.5rem;padding:0;min-width:0}
legend{font-family:var(--display);font-size:1.45rem;margin-bottom:.6rem;display:flex;align-items:center;gap:.55rem;padding:0}
legend .n{display:inline-grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;background:var(--amber);color:var(--deep);font-size:1.05rem}
.choices{display:flex;flex-wrap:wrap;gap:.5rem}
.choice{position:relative}
.choice input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.choice span{display:block;padding:.65rem .95rem;border-radius:10px;background:var(--chip);font-weight:700;cursor:pointer;min-height:44px}
.choice input:checked + span{background:var(--chip-on);color:var(--chip-on-ink)}
.choice input:focus-visible + span{outline:3px solid var(--amber);outline-offset:2px}
.choice em{display:block;font-style:normal;font-weight:400;font-size:.86rem;opacity:.85}
label.f,.f{display:block;font-weight:700;margin:.2rem 0 .35rem}
select,input[type=date],input[type=time],input[type=tel],input[type=text],input[type=search]{width:100%;padding:.7rem .8rem;border-radius:10px;border:1.5px solid var(--line);background:var(--surface);min-height:48px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.hint{font-size:.9rem;color:var(--muted);margin:.4rem 0 0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border:0;border-radius:12px;padding:.85rem 1.3rem;font-weight:700;cursor:pointer;min-height:48px;text-decoration:none}
.btn-main{background:var(--amber);color:var(--deep);width:100%;font-size:1.1rem}
.btn-main:hover{filter:brightness(1.05)}
.btn-main[disabled]{opacity:.6;cursor:wait}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn-link{background:none;border:0;color:var(--ink);text-decoration:underline;cursor:pointer;padding:.4rem 0;font-weight:700;display:inline-flex;align-items:center;gap:.35rem}
.btn-link svg{width:18px;height:18px}
.btn-danger{background:transparent;color:var(--rail);border:1.5px solid currentColor}
@media (prefers-color-scheme:dark){.btn-danger{color:#FF8A8F}}

/* Champ de recherche de lieu */
.place{position:relative}
.pbox{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);min-height:52px;padding-left:.7rem}
.pbox:focus-within{border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,167,27,.3)}
.pbox .ico{width:26px;height:26px;flex:none;color:var(--muted)}
.pbox input{border:0;outline:0;background:transparent;min-height:48px;padding:.6rem .6rem;flex:1;min-width:0}
.pbox .clear{background:none;border:0;cursor:pointer;color:var(--muted);padding:.5rem .7rem;font-size:1.3rem;line-height:1}
.pbox.picked{border-color:var(--navy)}
@media (prefers-color-scheme:dark){.pbox.picked{border-color:var(--amber)}}
.pbox.picked .ico{color:var(--ink)}
.listbox{list-style:none;margin:.35rem 0 0;padding:.3rem;position:absolute;left:0;right:0;z-index:25;background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 30px rgba(12,26,61,.18);max-height:min(60vh,420px);overflow:auto}
.listbox li{display:flex;gap:.7rem;align-items:flex-start;padding:.6rem .6rem;border-radius:9px;cursor:pointer}
.listbox li[aria-selected="true"],.listbox li:hover{background:var(--hover)}
.listbox li .ico{width:24px;height:24px;flex:none;margin-top:.1rem}
.listbox b{display:block;font-weight:700}
.listbox small{display:block;color:var(--muted);font-size:.86rem}
.listbox .msg{color:var(--muted);cursor:default}
.listbox .msg:hover{background:transparent}
.k-gare{color:var(--rail)} .k-bus{color:#2E6BD8} .k-sante{color:#1E8A5A} .k-ville,.k-adresse,.k-lieu,.k-position{color:var(--navy)}
@media (prefers-color-scheme:dark){.k-ville,.k-adresse,.k-lieu,.k-position{color:var(--amber)} .k-bus{color:#8DB4FF} .k-gare{color:#FF8A8F} .k-sante{color:#5FD39A}}
.place-tools{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap;margin-top:.2rem}
.swap{display:flex;justify-content:center;margin:-.6rem 0 .3rem}
.swap button{background:var(--chip);border:0;border-radius:999px;padding:.4rem .9rem;cursor:pointer;font-weight:700;display:flex;gap:.35rem;align-items:center}
.swap svg{width:18px;height:18px}
.help-when{margin-top:1rem;padding:1rem;border-radius:12px;background:var(--chip)}
.help-when .choice span{background:var(--surface)}
.help-when .choice input:checked + span{background:var(--chip-on)}

/* Résultats */
.results{min-width:0}
.res-head{margin-bottom:.8rem}
.res-head h2{font-size:1.7rem}
.res-head p{margin:.2rem 0 0;color:var(--muted)}
.opts{display:grid;gap:.6rem;margin-bottom:1rem}
.opt{display:block;width:100%;text-align:left;background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:.85rem 1rem;cursor:pointer}
.opt:hover{border-color:#9AA9CC}
.opt[aria-checked="true"]{border-color:var(--amber);box-shadow:0 0 0 3px rgba(242,167,27,.25)}
.opt-top{display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;flex-wrap:wrap}
.opt-times{font-family:var(--display);font-size:1.9rem;line-height:1}
.opt-times i{font-style:normal;color:var(--muted);font-size:1.3rem;margin:0 .3rem}
.opt-dur{color:var(--muted);font-size:.92rem}
.legs{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.55rem}
.leg{font-style:normal;font-size:.84rem;font-weight:700;padding:.18rem .55rem;border-radius:6px}
.leg.nav{background:#FDEFD2;color:#6B4700}
.leg.train{background:#F9DEE0;color:#8E1B22}
@media (prefers-color-scheme:dark){.leg.nav{background:#4A3A12;color:#FFD889}.leg.train{background:#4A1820;color:#FFC9CD}}
.detail{overflow:hidden;padding:0}
.arrive{background:var(--navy);color:#fff;padding:1.1rem 1.3rem 1rem}
.arrive p{margin:0;color:#C9D3EA}
.arrive .t{font-family:var(--display);font-size:clamp(3rem,9vw,4.2rem);line-height:.95;color:var(--amber)}
.arrive .where{font-weight:700;color:#fff;font-size:1.05rem}
.line{list-style:none;margin:0;padding:1.2rem 1.3rem .4rem}
.stop{display:grid;grid-template-columns:4.2rem 1.6rem minmax(0,1fr);gap:.2rem .6rem;position:relative;padding-bottom:1.15rem}
.stop .h{font-family:var(--display);font-size:1.35rem;text-align:right;line-height:1.2;white-space:nowrap}
.stop .dot{position:relative;display:flex;justify-content:center}
.stop .dot::before{content:"";width:16px;height:16px;border-radius:50%;background:var(--surface);border:4px solid var(--amber);margin-top:.25rem;z-index:1}
.stop .dot::after{content:"";position:absolute;top:1.1rem;bottom:-1.4rem;width:6px;background:var(--amber);border-radius:3px}
.stop.train .dot::after{background:repeating-linear-gradient(var(--rail) 0 10px,transparent 10px 14px)}
.stop.train .dot::before{border-color:var(--rail)}
.stop.wait .dot::after{background:repeating-linear-gradient(var(--line) 0 4px,transparent 4px 8px)}
.stop.wait .dot::before{border-color:var(--muted)}
.share{margin-top:1.2rem}
.share .choice span{min-width:13rem}
.ppl{display:inline-flex;align-items:center;gap:2px;margin-left:.35rem;padding-left:.4rem;border-left:1px solid currentColor}
.ppl svg{width:12px;height:12px}
.seats{display:flex;flex-wrap:wrap;align-items:center;gap:4px;margin-top:.4rem}
.seat{width:15px;height:15px;border-radius:4px;border:2px solid var(--line);background:transparent}
.seat.other{background:var(--navy);border-color:var(--navy)}
.seat.me{background:var(--amber);border-color:var(--amber)}
@media (prefers-color-scheme:dark){.seat.other{background:#AAB6D3;border-color:#AAB6D3}}
.seats small{flex-basis:100%;color:var(--muted);font-size:.86rem}
.seats small b{color:var(--ink)}
.stop.last .dot::after{display:none}
.stop.last .dot::before{background:var(--amber)}
.stop strong{display:block;overflow-wrap:anywhere}
.stop .d{color:var(--muted);font-size:.93rem;display:block}
.aid{display:inline-block;margin-top:.3rem;background:#DDF3E7;color:#14593A;font-size:.84rem;font-weight:700;padding:.15rem .55rem;border-radius:6px}
@media (prefers-color-scheme:dark){.aid{background:#173F2C;color:#9BE8C0}}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border-top:1px solid var(--line)}
.facts div{background:var(--surface);padding:.8rem 1.1rem}
.facts span{display:block;color:var(--muted);font-size:.85rem}
.facts b{font-size:1.02rem}
.planb{margin:0;padding:1rem 1.3rem;border-top:1px solid var(--line);font-size:.95rem}
.detail .actions{padding:0 1.3rem 1.3rem}
.empty{padding:2rem 1.3rem;text-align:center;color:var(--muted)}
.empty svg{width:120px;height:auto;margin-bottom:.6rem}
.err{background:#FDECEC;color:#8E1B22;border-radius:10px;padding:.8rem 1rem;margin:0}
@media (prefers-color-scheme:dark){.err{background:#4A1820;color:#FFD5D8}}
.loading{display:flex;gap:.8rem;align-items:center;color:var(--muted)}
.spin{width:26px;height:26px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--amber);animation:sp 0.9s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.demo{font-size:.82rem;color:var(--muted);padding:0 1.3rem 1rem;margin:0}

/* Mes trajets */
.trips{display:grid;gap:1rem}
@media (min-width:760px){.trips{grid-template-columns:1fr 1fr}}
.trip{background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--amber);border-radius:12px;padding:1rem 1.1rem}
.trip.cancelled{border-left-color:var(--muted);opacity:.7}
.trip h3{font-size:1.45rem;overflow-wrap:anywhere}
.trip p{margin:.3rem 0}
.code{font-family:var(--display);font-size:1.25rem;letter-spacing:.08em;background:var(--chip);padding:.1rem .5rem;border-radius:6px}
.trip .btns{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem}

/* Conseiller */
.help{display:grid;gap:1.2rem}
@media (min-width:860px){.help{grid-template-columns:1fr 1fr}}
.call{display:flex;align-items:center;gap:.8rem;background:var(--amber);color:var(--deep);border-radius:14px;padding:1.1rem 1.2rem;text-decoration:none}
.call b{font-family:var(--display);font-size:2rem;display:block;line-height:1}
.call svg{width:42px;height:42px;flex:none}
.ok{color:var(--ok);font-weight:700}

/* Le projet */
.proj{display:grid;gap:1.2rem}
@media (min-width:860px){.proj{grid-template-columns:repeat(3,1fr)}}
.proj h3{font-size:1.5rem;margin-bottom:.3rem}
.proj p{margin:.3rem 0;color:var(--muted)}
.quote{border-left:4px solid var(--amber);padding:.2rem 0 .2rem .9rem;margin:.9rem 0 0;font-style:italic}
.quote cite{display:block;font-style:normal;color:var(--muted);font-size:.9rem;margin-top:.2rem}
.steps{counter-reset:s;list-style:none;padding:0;margin:.5rem 0 0;display:grid;gap:.7rem}
.steps li{counter-increment:s;display:grid;grid-template-columns:2rem 1fr;gap:.6rem;align-items:start}
.steps li::before{content:counter(s);display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:var(--navy);color:#fff;font-weight:700}
@media (prefers-color-scheme:dark){.steps li::before{background:var(--amber);color:var(--deep)}}
.partners{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.6rem}
.partners span{background:var(--chip);border-radius:999px;padding:.3rem .8rem;font-weight:700;font-size:.92rem}
.wide{grid-column:1/-1}
footer{text-align:center;color:var(--muted);font-size:.85rem;padding:1rem 1rem 2rem}

/* Mobile */
@media (max-width:860px){
  .top nav.tabs{position:fixed;left:0;right:0;bottom:0;background:var(--navy);justify-content:space-around;padding:.35rem .3rem calc(.35rem + env(safe-area-inset-bottom,0px));border-top:1px solid #2B4383;gap:0}
  nav.tabs a{flex-direction:column;gap:.1rem;font-size:.78rem;padding:.4rem .5rem;flex:1;text-align:center}
  nav.tabs a[aria-current="page"]{box-shadow:inset 0 3px 0 var(--amber);background:transparent;color:var(--amber)}
  nav.tabs svg{width:24px;height:24px}
  .brand small{display:none}
  .brand img{height:40px}
  main{padding-bottom:calc(6.5rem + env(safe-area-inset-bottom,0px))}
}
@media (max-width:420px){.row{grid-template-columns:1fr}.stop{grid-template-columns:auto 1.4rem minmax(0,1fr)}}
@media (prefers-reduced-motion:reduce){.spin{animation-duration:3s}}
</style>
</head>
<body>

<header class="top">
  <div class="top-in">
    <a class="brand" href="#reserver" aria-label="Rurality, accueil">
      <span class="logo"><img src="data:image/png;base64," alt="Rurality" width="105" height="46"></span>
      <small>Le train pour tous et partout</small>
    </a>
    <nav class="tabs" aria-label="Navigation principale">
      <a href="#reserver" data-tab="reserver"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="3" width="16" height="13" rx="3"/><path d="M4 10h16M8 20l-2 2M16 20l2 2M8 16v4M16 16v4"/></svg>Réserver</a>
      <a href="#trajets" data-tab="trajets"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Mes trajets</a>
      <a href="#conseiller" data-tab="conseiller"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>Conseiller</a>
      <a href="#projet" data-tab="projet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>Le projet</a>
    </nav>
    <button class="textsize" id="textsize" aria-pressed="false" title="Agrandir le texte">A+</button>
  </div>
</header>

<main>
  <!-- RÉSERVER -->
  <section class="view" id="v-reserver" aria-labelledby="t-res">
    <h1 class="title" id="t-res">Où allez-vous ?</h1>
    <p class="lead">Partout en France : une adresse, une gare, un arrêt de bus, un cabinet médical ou un hôpital. Rurality vous amène jusqu’au train et vous récupère à l’arrivée.</p>

    <div class="book">
      <form class="panel" id="form" novalidate autocomplete="off">
        <fieldset>
          <legend><span class="n">1</span>D’où partez-vous ?</legend>
          <div class="place" id="p-from">
            <label class="f" for="from-q">Adresse, ville, gare, arrêt de bus…</label>
            <div class="pbox"><span class="ico"></span><input type="text" enterkeyhint="search" id="from-q" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="from-list" placeholder="Ex. 12 rue des Lilas, Oraison"><button type="button" class="clear" aria-label="Effacer le départ" hidden>×</button></div>
            <ul class="listbox" id="from-list" role="listbox" aria-label="Lieux de départ proposés" hidden></ul>
          </div>
          <div class="place-tools">
            <button type="button" class="btn-link" id="geoloc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>Utiliser ma position</button>
          </div>
        </fieldset>

        <div class="swap"><button type="button" id="swap" aria-label="Inverser départ et arrivée"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>Inverser</button></div>

        <fieldset>
          <legend><span class="n">2</span>Où devez-vous arriver ?</legend>
          <div class="place" id="p-to">
            <label class="f" for="to-q">Adresse, rendez-vous, hôpital, ville, gare…</label>
            <div class="pbox"><span class="ico"></span><input type="text" enterkeyhint="search" id="to-q" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="to-list" placeholder="Ex. Hôpital de la Timone, Marseille"><button type="button" class="clear" aria-label="Effacer l’arrivée" hidden>×</button></div>
            <ul class="listbox" id="to-list" role="listbox" aria-label="Lieux d’arrivée proposés" hidden></ul>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="n">3</span>Quand ?</legend>
          <div class="choices" style="margin-bottom:.8rem">
            <label class="choice"><input type="radio" name="when" value="arrive" checked><span>Arriver au plus tard à</span></label>
            <label class="choice"><input type="radio" name="when" value="depart"><span>Partir à partir de</span></label>
          </div>
          <div class="row">
            <div><label class="f" for="date">Date</label><input type="date" id="date" required></div>
            <div><label class="f" for="time" id="time-label">Heure d’arrivée</label><input type="time" id="time" value="10:00" step="300" required></div>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="n">4</span>Besoins particuliers</legend>
          <div class="choices">
            <label class="choice"><input type="checkbox" name="need" value="fauteuil"><span>Fauteuil roulant</span></label>
            <label class="choice"><input type="checkbox" name="need" value="aide"><span>Aide pour monter et descendre</span></label>
