 ["Lille Flandres",50.6366,3.0702],["Lille Europe",50.6394,3.0757],["Strasbourg",48.5850,7.7348],
 ["Grenoble",45.1914,5.7146],["Dijon-Ville",47.3233,5.0273],["Tours",47.3897,0.6939],
