const fmt = m => { m=((Math.round(m)%1440)+1440)%1440; return Math.floor(m/60)+" h "+String(m%60).padStart(2,"0"); };
const dur = m => { m=Math.round(m); return m<60 ? m+" min" : Math.floor(m/60)+" h "+String(m%60).padStart(2,"0"); };
