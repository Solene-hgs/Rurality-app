form.querySelectorAll("input[name=when]").forEach(r=>r.addEventListener("change",()=>{
  $("#time-label").textContent = form.when.value==="arrive" ? "Heure d’arrivée" : "Heure de départ";
}));
form.querySelectorAll("input[name=need]").forEach(c=>c.addEventListener("change",()=>{
  const any=form.querySelectorAll("input[name=need]:checked").length>0;
  const wasHidden=$("#help-when").hidden; $("#help-when").hidden=!any;
  if(any&&wasHidden&&!form.querySelectorAll("input[name=seg]:checked").length)
    form.querySelectorAll("input[name=seg]").forEach(s=>{ if(s.value!=="gare") s.checked=true; });
}));

/* ===================== Gares les plus proches ===================== */
const stationCache=new Map();
async function nearestStation(pt){
  if(pt.kind==="gare") return {name:pt.name.startsWith("Gare")?pt.name:"Gare de "+pt.name,lat:pt.lat,lon:pt.lon,self:true};
  const key=pt.lat.toFixed(2)+","+pt.lon.toFixed(2);
  if(stationCache.has(key)) return stationCache.get(key);
  let best=null;
  try{
    const q=`[out:json][timeout:8];nwr(around:25000,${pt.lat},${pt.lon})["railway"~"^(station|halt)$"]["station"!~"subway|light_rail|monorail|funicular|miniature"]["name"];out center 40;`;
    const j=await getJSON("https://overpass-api.de/api/interpreter?data="+encodeURIComponent(q),9000);
    for(const el of j.elements||[]){
      const lat=el.lat??el.center?.lat, lon=el.lon??el.center?.lon; if(lat==null) continue;
      const d=km(pt,{lat,lon});
      if(!best||d<best.d) best={name:/^gare/i.test(el.tags.name)?el.tags.name:"Gare de "+el.tags.name,lat,lon,d};
    }
  }catch(e){}
  if(!best){ for(const g of GARES){ const d=km(pt,g); if(!best||d<best.d) best={...g,d}; } }
  stationCache.set(key,best); return best;
}

/* ===================== Calcul des propositions ===================== */
const navMin = d => d<0.3 ? 0 : Math.max(6, Math.round(d*1.3/CONFIG.vitesseNavette*60)) + CONFIG.regroupement;
const trainInfo = d => d>180 ? {label:"Train grandes lignes",min:Math.round(d*1.2/190*60)+15,freq:120}
                             : {label:"TER",min:Math.round(d*1.25/70*60)+5,freq:60};
const r5 = m => Math.floor(m/5)*5, c5 = m => Math.ceil(m/5)*5;

function buildOptions(ctx){
  const {from,to,gA,gB,mode,T}=ctx, opts=[];
  const direct = km(from,to)<=CONFIG.distanceNavetteDirecte || gA.name===gB.name || km(gA,gB)<8;
  if(direct){
    const n=navMin(km(from,to)) || 8;
    const ends = mode==="arrive" ? [T-70,T-40,T-10].map(r5) : null;
    const starts = mode==="depart" ? [0,30,60].map(x=>c5(T)+x) : ends.map(e=>e-n);
    starts.forEach(s=>{ if(s>=300&&s+n<=1439) opts.push({start:s,end:s+n,direct:true,
      legs:[{type:"nav",seg:"avant",dep:s,arr:s+n,from:from.name,to:to.name}]}); });
    return opts;
  }
  const n1 = gA.self||km(from,gA)<0.4 ? 0 : navMin(km(from,gA));
  const n2 = gB.self||km(to,gB)<0.4 ? 0 : navMin(km(to,gB));
  const tr=trainInfo(km(gA,gB)), off=hash(gA.name+gB.name)%tr.freq;
  const deps=[]; for(let t=300+off;t<=1290;t+=tr.freq) deps.push(t);
  const all=deps.map(dep=>{
    const legs=[];
    if(n1) legs.push({type:"nav",seg:"avant",dep:dep-CONFIG.margeAvantTrain-n1,arr:dep-CONFIG.margeAvantTrain,from:from.name,to:gA.name});
    legs.push({type:"train",seg:"gare",label:tr.label,dep,arr:dep+tr.min,from:gA.name,to:gB.name});
    if(n2){ const s=dep+tr.min+CONFIG.attenteApresTrain; legs.push({type:"nav",seg:"apres",dep:s,arr:s+n2,from:gB.name,to:to.name}); }
    return {start:legs[0].dep,end:legs[legs.length-1].arr,legs};
  }).filter(o=>o.start>=270&&o.end<=1439);
  const res = mode==="arrive" ? all.filter(o=>o.end<=T).slice(-3) : all.filter(o=>o.start>=T).slice(0,3);
  res.all=all; return res;
}

let state=null, chosen=0;
const results=$("#results");
function showError(t){ results.innerHTML=`<div class="panel"><p class="err">${t}</p></div>`; }

form.addEventListener("submit",async e=>{
  e.preventDefault();
  const from=FROM.get(), to=TO.get();
  if(!from){ showError("Choisissez votre point de départ dans la liste proposée (étape 1)."); FROM.input.focus(); return; }
  if(!to){ showError("Choisissez votre lieu d’arrivée dans la liste proposée (étape 2)."); TO.input.focus(); return; }
  if(km(from,to)<0.3){ showError("Le départ et l’arrivée sont au même endroit."); return; }
  const date=$("#date").value, time=$("#time").value;
  if(!date||!time){ showError("Indiquez la date et l’heure (étape 3)."); return; }
  const needs=[...form.querySelectorAll("input[name=need]:checked")].map(i=>i.value);
  const segs=[...form.querySelectorAll("input[name=seg]:checked")].map(i=>i.value);
  if(needs.length&&!segs.length){ showError("Indiquez pour quelle partie du trajet vous avez besoin d’aide (étape 4)."); return; }

  const go=$("#go"); go.disabled=true;
  results.innerHTML=`<div class="panel"><p class="loading"><span class="spin"></span>Recherche des gares et des horaires…</p></div>`;
  if(matchMedia("(max-width:959px)").matches) results.scrollIntoView({behavior:"smooth",block:"start"});
  const [gA,gB]=await Promise.all([nearestStation(from),nearestStation(to)]);
  go.disabled=false;
  const mode=form.when.value, T=toMin(time);
  const options=buildOptions({from,to,gA,gB,mode,T});
  const share=form.share.value==="oui";
  const party=1+(needs.includes("accomp")?1:0);
  options.forEach(o=>o.legs.forEach(l=>{
    if(l.type!=="nav") return;
    l.helped=needs.includes("fauteuil")&&(o.direct?segs.length>0:segs.includes(l.seg));
    l.shared=share; l.party=party;
    l.cap=share?(l.helped?CONFIG.placesVehiculeAdapte:CONFIG.placesMinibus):party;
    const room=l.cap-party;
    l.others=share&&room>0 ? 1+hash(l.from+l.to+l.dep+date)%room : 0;
    if(l.others>=room) l.others=Math.max(0,room-1);
    l.riders=party+l.others;
  }));
  if(!options.length){
    showError(mode==="arrive" ? "Aucun trajet n’arrive avant "+fmt(T)+". Essayez une heure plus tardive ou un autre jour."
                              : "Aucun trajet ne part après "+fmt(T)+" ce jour-là. Essayez plus tôt ou le lendemain.");
    return;
  }
  state={from,to,gA,gB,date,mode,T,needs,segs,options,share}; chosen=mode==="arrive"?options.length-1:0;
  renderResults();
});

const NEED_TXT={fauteuil:"fauteuil roulant",aide:"aide pour monter",vue:"accompagnement malvoyant",accomp:"accompagnant",bagage:"valise ou poussette"};
function helpFor(leg){
  const s=state; if(!s.needs.length) return "";
  const direct=s.options[0].direct;
  if(!(direct ? s.segs.length : s.segs.includes(leg.seg))) return "";
  if(leg.type==="train") return "Assistance en gare et à bord demandée";
  return "Aide prévue : "+s.needs.map(n=>NEED_TXT[n]).join(", ");
}
function vehicleFor(leg){
  if(!leg.shared) return leg.helped ? "Véhicule adapté avec rampe, rien que pour vous" : "Voiture rien que pour vous";
  return leg.helped ? "Véhicule adapté partagé ("+leg.cap+" places, rampe)" : "Minibus partagé ("+leg.cap+" places)";
}
const PERSON='<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21a8 8 0 0 1 16 0z"/></svg>';
function seatsHTML(L){
  if(L.type!=="nav") return "";
  if(!L.shared) return `<span class="seats"><small>Navette privée : vous${L.party>1?" et votre accompagnant":""}, personne d’autre à bord</small></span>`;
  let dots="";
  for(let i=0;i<L.cap;i++) dots+=`<span class="seat ${i<L.party?"me":i<L.riders?"other":""}"></span>`;
  const txt = L.others
    ? `Vous serez <b>${L.riders} à bord</b> sur ${L.cap} places : vous${L.party>1?" et votre accompagnant":""}, et ${L.others} autre${L.others>1?"s":""} voyageur${L.others>1?"s":""} du secteur`
    : `Pour l’instant, personne d’autre n’a réservé cette navette (${L.cap} places)`;
  return `<span class="seats" role="img" aria-label="${L.riders} voyageurs sur ${L.cap} places">${dots}<small>${txt}</small></span>`;
}

function renderResults(){
  const s=state;
  const optHTML=s.options.map((o,i)=>{
    const nTrain=o.legs.filter(l=>l.type==="train").length;
    return `<button type="button" class="opt" role="radio" aria-checked="${i===chosen}" data-i="${i}">
      <span class="opt-top"><span class="opt-times">${fmt(o.start)}<i>→</i>${fmt(o.end)}</span>
      <span class="opt-dur">${dur(o.end-o.start)}${o.direct?", trajet direct":nTrain&&o.legs.length>1?", "+(o.legs.length-1)+" correspondance"+(o.legs.length>2?"s":""):""}</span></span>
      <span class="legs">${o.legs.map(l=>`<i class="leg ${l.type}">${l.type==="train"?esc(l.label):(l.shared?"Navette":"Navette privée")} ${dur(l.arr-l.dep)}${l.type==="nav"?`<span class="ppl" title="${l.riders} voyageur${l.riders>1?"s":""} à bord">${PERSON}${l.riders}</span>`:""}</i>`).join("")}</span>
    </button>`;}).join("");
  results.innerHTML=`
    <div class="res-head"><h2>${s.options.length} proposition${s.options.length>1?"s":""}</h2>
      <p>${esc(s.from.name)} vers ${esc(s.to.name)}, ${esc(dateFR(s.date))}</p></div>
    <div class="opts" role="radiogroup" aria-label="Propositions de trajet">${optHTML}</div>
    <div class="panel detail" id="detail"></div>`;
  results.querySelectorAll(".opt").forEach(b=>b.addEventListener("click",()=>{ chosen=+b.dataset.i;
    results.querySelectorAll(".opt").forEach(x=>x.setAttribute("aria-checked",x===b)); renderDetail(); }));
  renderDetail();
}

function renderDetail(){
  const s=state, o=s.options[chosen], legs=o.legs, stops=[];
  legs.forEach((L,i)=>{
    const P=legs[i-1];
    if(P&&L.dep>P.arr) stops.push({h:P.arr,t:L.from,cls:"wait",
      d: L.type==="train" ? "Arrivée en gare, "+(L.dep-P.arr)+" min avant le train" : "Sortie du train, la navette vous attend"});
    const help=helpFor(L);
    stops.push({h:L.dep,cls:L.type,help,seats:seatsHTML(L),
      t: L.type==="train" ? "Départ du "+L.label+" à "+L.from : (i===0?"Prise en charge : "+L.from:"Navette depuis "+L.from),
      d: L.type==="train" ? "Direction "+L.to+", "+dur(L.arr-L.dep)+" de trajet" : vehicleFor(L)+" jusqu’à "+L.to+", "+dur(L.arr-L.dep)});
  });
  stops.push({h:o.end,t:s.to.name,d:s.to.sub||"Arrivée",cls:"last"});
  const navs=legs.filter(l=>l.type==="nav").length;
  const next=(s.options.all||[]).find(x=>x.start>o.start);
  const trainLeg=legs.find(l=>l.type==="train");
  const planb = trainLeg
    ? (next ? "Si la navette a du retard, votre place est reportée sur le départ de "+fmt(next.start)+" et un conseiller vous appelle." : "Si la navette a du retard, un conseiller vous appelle et organise un trajet de secours.")
    : "En cas de retard, le chauffeur et un conseiller vous préviennent par téléphone.";
  $("#detail").innerHTML=`
    <div class="arrive"><p>${s.mode==="arrive"?"Arrivée garantie":"Arrivée prévue"} ${esc(dateFR(s.date))}</p>
      <div class="t">${fmt(o.end)}</div><p class="where">${esc(s.to.name)}</p></div>
    <ol class="line">${stops.map(st=>`<li class="stop ${st.cls}"><span class="h">${fmt(st.h)}</span><span class="dot" aria-hidden="true"></span>
      <span><strong>${esc(st.t)}</strong><span class="d">${esc(st.d)}</span>${st.seats||""}${st.help?`<span class="aid">${esc(st.help)}</span>`:""}</span></li>`).join("")}</ol>
    <div class="facts">
      <div><span>Soyez prêt à</span><b>${fmt(o.start-5)}</b></div>
      <div><span>Navette${navs>1?"s":""}</span><b>${euro(navs*(s.share?CONFIG.prixNavette:CONFIG.prixNavetteSeule))}${trainLeg?", billet de train à part":""}</b></div>
      <div><span>Partage</span><b>${s.share?"Navette partagée, "+Math.max(...legs.filter(l=>l.type==="nav").map(l=>l.cap))+" personnes maximum":"Navette privée"}</b></div>
      ${s.needs.length?`<div><span>Besoins pris en compte</span><b>${s.needs.map(n=>NEED_TXT[n]).join(", ")}</b></div>`:""}
    </div>
    ${s.share?`<p class="planb"><strong>Mutualisation :</strong> d’autres voyageurs peuvent encore réserver jusqu’à la veille, sans jamais dépasser le nombre de places. Vous serez prévenu du nombre final de passagers.</p>`:""}
    <p class="planb"><strong>Plan B :</strong> ${esc(planb)}</p>
    <div class="actions"><button class="btn btn-main" id="confirm">Réserver le trajet de ${fmt(o.start)}</button></div>
    <p class="demo">Prototype : lieux réels, gares trouvées automatiquement, horaires de train simulés.</p>`;
  $("#confirm").addEventListener("click",confirmTrip);
}

function confirmTrip(){
  const s=state, o=s.options[chosen];
  const code="R-"+hash(JSON.stringify(o)+Date.now()).toString(36).toUpperCase().slice(-4).padStart(4,"0");
  const trips=store.get();
  trips.unshift({code,status:"ok",from:s.from.name,to:s.to.name,date:s.date,start:o.start,end:o.end,
    legs:o.legs.map(l=>l.type==="train"?l.label+" "+dur(l.arr-l.dep):(l.shared?"Navette ":"Navette privée ")+dur(l.arr-l.dep)+", "+l.riders+" à bord"),needs:s.needs});
  store.set(trips);
  results.innerHTML=`<div class="panel" style="padding:1.4rem">
    <p class="ok">Trajet réservé</p>
    <h2 style="font-size:2rem;margin:.3rem 0">Code ${code}</h2>
    <p>Prise en charge à <strong>${fmt(o.start)}</strong> le ${esc(dateFR(s.date))}, ${esc(o.legs[0].type==="nav"?"à "+s.from.name:"en gare de départ")}.</p>
    <p>Vous recevrez un rappel la veille. Montrez ce code au chauffeur.</p>
    <div style="display:grid;gap:.6rem;margin-top:1rem">
      <a class="btn btn-main" href="#trajets">Voir mes trajets</a>
      <button class="btn btn-ghost" id="ret">Réserver le retour</button>
    </div></div>`;
  $("#ret").addEventListener("click",()=>{ const a=s.from,b=s.to; FROM.set(b); TO.set(a);
    form.querySelector("input[name=when][value=depart]").checked=true; $("#time-label").textContent="Heure de départ";
    $("#time").value=String(Math.floor((o.end+60)/60)%24).padStart(2,"0")+":"+String((o.end+60)%60).padStart(2,"0");
    window.scrollTo({top:0,behavior:"smooth"}); });
}

/* ===================== Mes trajets ===================== */
function renderTrips(){
  const box=$("#trips"), trips=store.get();
  if(!trips.length){
    box.innerHTML=`<div class="panel empty" style="grid-column:1/-1"><p>Aucun trajet réservé pour l’instant.</p><a class="btn btn-main" href="#reserver" style="max-width:320px;margin:0 auto">Réserver un trajet</a></div>`;
    return;
  }
  box.innerHTML=trips.map((t,i)=>`
    <article class="trip ${t.status==="annule"?"cancelled":""}">
      <h3>${esc(t.from)} vers ${esc(t.to)}</h3>
      <p>${esc(dateFR(t.date))}</p>
      <p>Départ <strong>${fmt(t.start)}</strong>, arrivée <strong>${fmt(t.end)}</strong></p>
      <p class="legs">${(t.legs||[]).map(l=>`<i class="leg ${/^Navette/.test(l)?"nav":"train"}">${esc(l)}</i>`).join("")}</p>
      <p>Code <span class="code">${esc(t.code)}</span> ${t.status==="annule"?"<strong>annulé</strong>":""}</p>
      <div class="btns">${t.status!=="annule"?`<button class="btn btn-danger" data-cancel="${i}">Annuler ce trajet</button>`:`<button class="btn btn-ghost" data-del="${i}">Retirer de la liste</button>`}</div>
    </article>`).join("");
}
$("#trips").addEventListener("click",e=>{
  const b=e.target.closest("button"); if(!b) return;
  const trips=store.get();
  if(b.dataset.cancel!==undefined){ if(!confirm("Annuler ce trajet ?")) return; trips[b.dataset.cancel].status="annule"; }
  else if(b.dataset.del!==undefined){ trips.splice(b.dataset.del,1); }
  store.set(trips); renderTrips();
});

/* ===================== Navigation ===================== */
const TABS=["reserver","trajets","conseiller","projet"];
function route(){
  const t=TABS.includes(location.hash.slice(1))?location.hash.slice(1):"reserver";
  TABS.forEach(x=>$("#v-"+x).classList.toggle("on",x===t));
  document.querySelectorAll("nav.tabs a").forEach(a=>a.dataset.tab===t?a.setAttribute("aria-current","page"):a.removeAttribute("aria-current"));
  if(t==="trajets") renderTrips();
  window.scrollTo(0,0);
}
addEventListener("hashchange",route);

/* Taille du texte */
const ts=$("#textsize");
function setBig(on){ document.documentElement.classList.toggle("big",on); ts.setAttribute("aria-pressed",on); try{localStorage.setItem("rurality-big",on?"1":"0")}catch(e){} }
ts.addEventListener("click",()=>setBig(ts.getAttribute("aria-pressed")!=="true"));
try{ if(localStorage.getItem("rurality-big")==="1") setBig(true); }catch(e){}

/* Conseiller */
$("#phone").textContent=CONFIG.telephone;
$("#call").href="tel:"+CONFIG.telephone.replace(/\s/g,"");
$("#callback").addEventListener("submit",e=>{
  e.preventDefault();
  const n=$("#cb-name").value.trim(), t=$("#cb-tel").value.replace(/[\s.]/g,""), m=$("#cb-msg");
  if(!n){ m.textContent="Indiquez votre nom."; m.className="hint"; return; }
  if(!/^(\+33|0)[1-9]\d{8}$/.test(t)){ m.textContent="Le numéro doit comporter 10 chiffres, par exemple 06 12 34 56 78."; m.className="hint"; return; }
  m.textContent="Demande enregistrée. Un conseiller vous rappellera ("+$("#cb-when").value.toLowerCase()+")."; m.className="ok"; e.target.reset();
});

route();
</script>
