const ICON = {
 gare:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="13" rx="3"/><path d="M5 10h14M9 19l-2 2M15 19l2 2M9 13h.01M15 13h.01"/></svg>',
 bus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 11h16M7 18v3M17 18v3M8 15h.01M16 15h.01"/></svg>',
 sante:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/></svg>',
 ville:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9l5-3v15M10 21V4l9 4v13M14 11h2M14 15h2"/></svg>',
 adresse:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6"/></svg>',
 lieu:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>',
 position:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>',
 search:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>'
};
const KIND = {gare:"Gare",bus:"Arrêt de bus",sante:"Santé",ville:"Ville",adresse:"Adresse",lieu:"Lieu",position:"Ma position"};

/* ===================== Recherche de lieux (toute la France) ===================== */
const one = v => Array.isArray(v) ? v[0] : v;
function fromGeoAddress(f){
  const p=f.properties,[lon,lat]=f.geometry.coordinates;
  if(p.type==="municipality") return {kind:"ville",name:p.city||p.name,sub:[p.postcode,p.context].filter(Boolean).join(", "),lat,lon};
  return {kind:"adresse",name:p.name||p.label,sub:[p.postcode,p.city].filter(Boolean).join(" "),lat,lon};
}
function fromGeoPoi(f){
  const p=f.properties,[lon,lat]=f.geometry.coordinates;
  const cat=norm([].concat(p.category||[]).join(" "));
  const name=one(p.name)||p.toponym||one(p.city); if(!name) return null;
  let kind="lieu";
  if(/routi|bus/.test(cat)) kind="bus";
  else if(/gare|halte|ferr/.test(cat)) kind="gare";
  else if(/sante|hopit|clini|medic|hospital/.test(cat)) kind="sante";
  else if(/commune|chef-lieu|ville/.test(cat)) kind="ville";
  return {kind,name,sub:[one(p.postcode),one(p.city)].filter(Boolean).join(" "),lat,lon};
}
function fromPhoton(f){
  const p=f.properties,[lon,lat]=f.geometry.coordinates;
  if(p.countrycode && p.countrycode!=="FR") return null;
  const k=p.osm_key,v=p.osm_value||"";
  let kind="lieu";
  if((k==="railway"&&/station|halt/.test(v))||(k==="public_transport"&&v==="station"&&/gare/i.test(p.name||""))) kind="gare";
  else if(v==="bus_stop"||v==="bus_station"||(k==="public_transport"&&v==="platform")) kind="bus";
  else if(k==="healthcare"||/hospital|clinic|doctors|dentist|pharmacy|physiotherapist/.test(v)) kind="sante";
  else if(k==="place"&&/city|town|village|hamlet|municipality|suburb/.test(v)) kind="ville";
  else if(p.type==="house"||p.type==="street"||k==="building") kind="adresse";
  const street=[p.housenumber,p.street].filter(Boolean).join(" ");
  const name=p.name||street; if(!name) return null;
  const sub=[p.name&&street?street:"",[p.postcode,p.city&&p.city!==name?p.city:""].filter(Boolean).join(" ")].filter(Boolean).join(", ")
            || [p.county,p.state].filter(Boolean).join(", ");
  return {kind,name,sub,lat,lon};
}
async function searchPlaces(q){
  const e=encodeURIComponent(q);
  const local=GARES.filter(g=>norm(g.name).includes(norm(q))).slice(0,3);
  const res=await Promise.allSettled([
    getJSON(`https://data.geopf.fr/geocodage/search?q=${e}&index=address&limit=5`),
    getJSON(`https://photon.komoot.io/api/?q=${e}&lang=fr&limit=8&bbox=-5.3,41.2,9.7,51.2`),
    getJSON(`https://data.geopf.fr/geocodage/search?q=${e}&index=poi&limit=5`)
  ]);
  const pick=(r,fn)=>r.status==="fulfilled"&&r.value&&r.value.features?r.value.features.map(fn).filter(Boolean):[];
  const addr=pick(res[0],fromGeoAddress), pho=pick(res[1],fromPhoton), poi=pick(res[2],fromGeoPoi);
  const failed=res.every(r=>r.status==="rejected");
  const ordered=/^\d/.test(q.trim()) ? [...addr,...pho,...poi,...local] : [...local,...pho,...addr,...poi];
  const seen=new Set(), out=[];
  for(const it of ordered){
    const key=norm(it.name)+"|"+it.lat.toFixed(3)+","+it.lon.toFixed(3);
    if(seen.has(key)) continue; seen.add(key); out.push(it);
    if(out.length>=8) break;
  }
  return {items:out,failed:failed&&!local.length};
}

/* Champ de lieu avec suggestions */
function PlaceField(id){
  const root=$("#p-"+id), input=$("#"+id+"-q"), list=$("#"+id+"-list"), box=root.querySelector(".pbox"),
        ico=box.querySelector(".ico"), clear=box.querySelector(".clear");
  let items=[], active=-1, value=null, timer=null, seq=0;
  const setIcon=k=>{ ico.className="ico"+(k?" k-"+k:""); ico.innerHTML=ICON[k||"search"]; };
  setIcon();
  function open(){ list.hidden=false; input.setAttribute("aria-expanded","true"); }
  function close(){ list.hidden=true; input.setAttribute("aria-expanded","false"); active=-1; input.removeAttribute("aria-activedescendant"); }
  function msg(t){ list.innerHTML=`<li class="msg">${t}</li>`; open(); }
  function render(){
    if(!items.length){ msg("Aucun lieu trouvé. Essayez le nom de la ville ou une adresse plus complète."); return; }
    list.innerHTML=items.map((it,i)=>`<li role="option" id="${id}-o${i}" data-i="${i}" aria-selected="${i===active}">
      <span class="ico k-${it.kind}" aria-hidden="true">${ICON[it.kind]}</span>
      <span><b>${esc(it.name)}</b><small>${esc(KIND[it.kind])}${it.sub?", "+esc(it.sub):""}</small></span></li>`).join("");
    open();
  }
  function set(v){
    value=v; box.classList.toggle("picked",!!v); setIcon(v&&v.kind);
    input.value=v ? v.name+(v.sub&&v.kind!=="gare"?", "+v.sub:"") : ""; clear.hidden=!v&&!input.value; close();
    root.dispatchEvent(new Event("change",{bubbles:true}));
  }
  input.addEventListener("input",()=>{
    value=null; box.classList.remove("picked"); setIcon(); clear.hidden=!input.value;
    clearTimeout(timer); const q=input.value.trim();
    if(q.length<3){ close(); return; }
    msg('<span class="loading"><span class="spin"></span>Recherche…</span>');
    timer=setTimeout(async()=>{
      const my=++seq; const r=await searchPlaces(q); if(my!==seq) return;
      if(r.failed){ msg("Recherche indisponible. Vérifiez votre connexion internet."); return; }
      items=r.items; active=-1; render();
    },300);
  });
  input.addEventListener("keydown",e=>{
    if(list.hidden||!items.length) return;
    if(e.key==="ArrowDown"||e.key==="ArrowUp"){ e.preventDefault();
      active=(active+(e.key==="ArrowDown"?1:-1)+items.length)%items.length; render();
      input.setAttribute("aria-activedescendant",id+"-o"+active);
      $("#"+id+"-o"+active)?.scrollIntoView({block:"nearest"}); }
    else if(e.key==="Enter"){ e.preventDefault(); set(items[active<0?0:active]); }
    else if(e.key==="Escape"){ close(); }
  });
  input.addEventListener("blur",()=>setTimeout(close,150));
  input.addEventListener("focus",()=>{ if(!value&&items.length&&input.value.trim().length>=3) render(); });
  list.addEventListener("mousedown",e=>{ const li=e.target.closest("li[data-i]"); if(li){ e.preventDefault(); set(items[+li.dataset.i]); }});
  clear.addEventListener("click",()=>{ items=[]; set(null); input.focus(); });
  return {get:()=>value, set, input};
}
const FROM=PlaceField("from"), TO=PlaceField("to");

$("#swap").addEventListener("click",()=>{ const a=FROM.get(), b=TO.get(); FROM.set(b); TO.set(a); });
$("#geoloc").addEventListener("click",()=>{
  const b=$("#geoloc");
  if(!navigator.geolocation){ alert("La localisation n’est pas disponible sur cet appareil."); return; }
  b.disabled=true; b.lastChild.textContent="Localisation en cours…";
  navigator.geolocation.getCurrentPosition(async pos=>{
    const lat=pos.coords.latitude, lon=pos.coords.longitude;
    let place={kind:"position",name:"Ma position",sub:"",lat,lon};
    try{
      const j=await getJSON(`https://data.geopf.fr/geocodage/reverse?lon=${lon}&lat=${lat}&index=address&limit=1`);
      if(j.features&&j.features[0]){ const a=fromGeoAddress(j.features[0]); place={...a,kind:"position",lat,lon}; }
    }catch(e){}
    FROM.set(place); b.disabled=false; b.lastChild.textContent="Utiliser ma position";
  },()=>{ b.disabled=false; b.lastChild.textContent="Utiliser ma position"; alert("Impossible d’obtenir votre position. Autorisez la localisation ou tapez votre adresse."); },{timeout:10000});
});

